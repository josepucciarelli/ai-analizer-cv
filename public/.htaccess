# SPA: todas las rutas que no sean archivos reales van a index.html
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# El worker de pdf.js es .mjs: necesita servirse como JavaScript
AddType application/javascript .mjs
